  "narrative": {
    "northStar": "Graphite robotics laboratory",
    "overview": "A graphite exhibition space opens into a precise, inspectable robotics workstation. Near-black graphite and deep charcoal establish the ground; soft white, cool gray and restrained ice blue keep the interface technical and calm. Real robot geometry supplies the cinematic focal material.\n\nUse technical sans typography for hierarchy and reading, and monospaced values for measurements and recording identity. Thin dividers and tonal surfaces organize dense controls. Motion stays subtle and respects reduced-motion preferences.",
    "keyCharacteristics": [
      "Near-black graphite and deep charcoal surfaces.",
      "Soft white and cool gray with restrained ice blue.",
      "Technical sans typography and monospaced measurements.",
      "Real robot geometry, inspectable evidence and subtle motion."
    ],
    "rules": [
      {
        "name": "The Evidence Status Rule",
        "body": "Pair every evidence status color with a readable status label.",
        "section": "colors"
      },
      {
        "name": "The Measurement Type Rule",
        "body": "Use mono for measured values and recording identity, and sans for reading and interface hierarchy.",
        "section": "typography"
      },
      {
        "name": "The Structural Depth Rule",
        "body": "Reserve interface shadows for the mobile inspector overlay; use surfaces and separators for ordinary grouping.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use real robot geometry and measured recording values.",
      "Do reserve ice blue for emphasis, selected controls, links and data traces.",
      "Do pair evidence status color with explicit text.",
      "Do retain visible keyboard focus and reduced-motion behavior.",
      "Do keep physical units, provenance and recording identity legible."
    ],
    "donts": [
      "Don't introduce a generic dashboard card grid as the visual identity.",
      "Don't fabricate telemetry or decorate the interface with invented signals.",
      "Don't add ornamental glow, heavy shadows or competing accent palettes.",
      "Don't use motion as the only way to communicate state."
    ]
  }
}
